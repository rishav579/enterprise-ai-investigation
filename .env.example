# Enterprise AI Investigation & Decision System - Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Database Configuration (defaults to local SQLite)
APP_DATABASE_URL=sqlite:///data/enterprise.db

# Deterministic Seed & Synthetic Data Configuration
APP_RANDOM_SEED=42
APP_SYNTHETIC_CUSTOMER_COUNT=500

# CORS Allowed Origins (comma-separated list of origins, or * for public APIs)
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Frontend API Base URL (leave empty for same-origin relative URLs in unified deployment)
# For decoupled frontend hosting (e.g. Vercel): set to backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=
