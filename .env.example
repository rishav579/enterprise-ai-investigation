# Enterprise AI Investigation & Decision System - Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Database Configuration (defaults to local SQLite)
APP_DATABASE_URL=sqlite:///data/enterprise.db

# Deterministic Seed & Synthetic Data Configuration
APP_RANDOM_SEED=42
APP_SYNTHETIC_CUSTOMER_COUNT=500

# CORS Allowed Origins (comma-separated list of origins, or * for public APIs)
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# API Key Protection for /investigations/* endpoints
# When set, every /investigations/* request must send a matching 'X-API-Key' header.
# Requests without the header (or with an incorrect key) receive HTTP 401.
# Leave unset/empty to disable protection (development/demo mode).
# '/health' and '/ready' always remain unauthenticated for platform probes.
INVESTIGATION_API_KEY=

# Frontend API Base URL (leave empty for same-origin relative URLs in unified deployment)
# For decoupled frontend hosting (e.g. Vercel): set to backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=

# Frontend copy of the investigation API key (baked into the SPA at build time).
# Set to the same value as INVESTIGATION_API_KEY when the backend key is enabled.
VITE_INVESTIGATION_API_KEY=
